{
  "name": "cresium-mcp-server",
  "version": "3.0.0",
  "private": true,
  "description": "Remote MCP server for the Cresium V3 API and docs",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "spec:update": "bun scripts/generate-spec.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:sandbox": "SANDBOX_IT=1 bun test test/sandbox.test.ts",
    "test:docs": "DOCS_IT=1 bun test test/mintlify.test.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "^8.17.1",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.4",
    "pino": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cresium/eslint-config": "0.1.1",
    "@cresium/prettier-config": "0.1.0",
    "@types/bun": "1.3.11",
    "@types/express": "^5.0.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
